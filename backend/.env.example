# ==============================================================================
# EstateCore Backend Configuration (.env)
# ==============================================================================
# NOTE: The credentials below are LOCAL ACADEMIC DEMONSTRATION VALUES.
# For production or staging environments, generate unique secure passwords
# and a cryptographically strong JWT secret using:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==============================================================================

NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# Database Configuration (MySQL 8.4 via Docker Compose on Port 3307)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USERNAME=estatecore_user
DB_PASSWORD=estatecore_secure_pass_2026

# DATABASE SELECTION GUIDE:
# - Option A (Recommended for new clones / clean setup):
#     Set DB_NAME=estatecore_db (default database created by docker-compose.yml)
#     Then run migrations (`npm run migration:run`) or import SQL dump (`documentation/deliverables/EstateCore_Final_Project.sql`).
# - Option B (Author's pre-migrated sandbox on port 3307):
#     Set DB_NAME=estatecore_test_restore
DB_NAME=estatecore_db

# ------------------------------------------------------------------------------
# Authentication (JWT)
# ------------------------------------------------------------------------------
# Academic Specification: Exactly 1 hour (3600 seconds) lifespan per estatecire.pdf (Lab 06, p. 20)
JWT_SECRET=estatecore_super_secret_jwt_key_2026_academic_defense_key
JWT_EXPIRATION=3600s
