# ==============================================================================
# EstateCore Root Environment Configuration (.env)
# ==============================================================================
# NOTE: The credentials below are LOCAL ACADEMIC DEMONSTRATION VALUES.
# For production or staging environments, generate unique secure passwords
# and a cryptographically strong JWT secret using:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ==============================================================================

# Application
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# Database Configuration (Docker MySQL 8.4)
# Host port 3307 is mapped to container port 3306 to avoid XAMPP/WAMP conflicts
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USERNAME=estatecore_user
DB_PASSWORD=estatecore_secure_pass_2026
DB_NAME=estatecore_db
MYSQL_ROOT_PASSWORD=estatecore_root_secure_pass_2026

# ------------------------------------------------------------------------------
# Authentication (JWT)
# Academic Specification: Exactly 1 hour (3600 seconds) lifespan per estatecire.pdf (Lab 06, p. 20)
# ------------------------------------------------------------------------------
JWT_SECRET=estatecore_super_secret_jwt_key_2026_academic_defense_key
JWT_EXPIRATION=3600s

# ------------------------------------------------------------------------------
# Frontend Configuration
# Relative /api uses Vite reverse proxy for automatic cross-device LAN access
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=/api
