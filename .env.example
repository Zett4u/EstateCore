# Environment Configuration for EstateCore

# Application
NODE_ENV=development
PORT=3000

# Database Configuration (Docker MySQL 8.4)
# Default host is 127.0.0.1; Port 3307 is used to avoid port 3306 conflicts with other local services
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USERNAME=estatecore_user
DB_PASSWORD=your_secure_password_here
DB_NAME=estatecore_db
MYSQL_ROOT_PASSWORD=your_root_password_here

# Container internal host if backend is containerized in docker network
# DB_HOST=mysql
# DB_PORT=3306

# Authentication (JWT)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRATION=86400s

# Frontend API URL
VITE_API_BASE_URL=http://localhost:3000/api
