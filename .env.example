# Environment Configuration for EstateCore

# Application
NODE_ENV=development
PORT=3000

# Database Configuration (Docker MySQL 8.4)
# Default host is 127.0.0.1; Port 3307 avoids port 3306 conflicts with XAMPP/WAMP
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USERNAME=estatecore_user
DB_PASSWORD=estatecore_secure_pass_2026
DB_NAME=estatecore_db
MYSQL_ROOT_PASSWORD=estatecore_root_secure_pass_2026

# Authentication (JWT)
JWT_SECRET=estatecore_super_secret_jwt_key_2026_academic_defense_key
JWT_EXPIRATION=86400s

# Frontend API URL (Relative /api uses Vite reverse proxy for mobile & cross-device compatibility)
VITE_API_BASE_URL=/api
