{
  "name": "estatecore-monorepo",
  "version": "1.0.0",
  "description": "EstateCore - Full-Stack Real Estate Management Information System (ITEC 116)",
  "private": true,
  "scripts": {
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:stop": "docker compose stop",
    "docker:logs": "docker compose logs -f mysql",
    "backend:dev": "cd backend && npm run start:dev",
    "backend:build": "cd backend && npm run build",
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "db:migrate": "cd backend && npm run migration:run",
    "db:seed": "cd backend && npm run seed"
  },
  "keywords": [
    "real-estate",
    "nestjs",
    "typeorm",
    "mysql",
    "react",
    "vite",
    "docker"
  ],
  "author": "ITEC 116 Student",
  "license": "ISC",
  "devDependencies": {
    "playwright": "^1.65.1"
  }
}
